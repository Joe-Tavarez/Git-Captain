# Lambda-specific configuration
# Override defaults when running in AWS Lambda

AWS_REGION=us-east-2
AWS_LAMBDA_FUNCTION_NAME=git-captain
NODE_ENV=production

# GitHub OAuth - will be stored in Secrets Manager
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_ORG_NAME=ConfusedDeer

# API endpoints (Lambda uses API Gateway)
GITHUB_API_ENDPOINT=https://api.github.com
GITHUB_OAUTH_ENDPOINT=https://github.com/login/oauth/access_token

# Logging
LOG_LEVEL=info
CLOUDWATCH_LOG_GROUP=/aws/lambda/prod-git-captain

# No SSL needed in Lambda (API Gateway handles it)
# privateKeyPath and certificatePath are not used

# Rate limiting (handled by API Gateway)
RATE_LIMIT_ENABLED=false

# Session timeout (30 minutes)
SESSION_TIMEOUT=1800000
